# Copy this file to .env and fill in your real values. Never commit .env itself.

# Get this from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local MongoDB, or a free MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/trading_research_assistant

# Port the Express server runs on
PORT=5000
